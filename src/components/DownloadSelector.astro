---
import { bestLocaleFor, localeFromPath, localePath } from "../i18n";
import { formatBytes, formatDate, releasesPageUrl } from "../lib/downloads";
import { binaryArtifact, getPreviewChannel, mirrorDownload, primaryDownload } from "../lib/release-channel";

/* Everything below reads off a channel: the platform picker, the checksum, the
   size. With no release published there is nothing to pick between, so the
   component renders a single "not published yet" notice instead of four empty
   panels that look like a broken page. */
const channel = await getPreviewChannel();
const defaultTarget = channel?.targets.find((target) => target.status === "available") ?? channel?.targets[0] ?? null;
/* The primary block above the picker: one button for the target a visitor most
   likely wants, so the common case is zero decisions. It renders off the same
   default the picker preselects, and the client script keeps the two in step. */
const defaultArtifact = defaultTarget ? binaryArtifact(defaultTarget) : null;
const defaultDownload = defaultArtifact ? primaryDownload(defaultArtifact) : null;
const defaultMirror = defaultArtifact ? mirrorDownload(defaultArtifact) : null;
/* The sidebar notice describes macOS signing, so it reads the same per-target
   state the signing row reads. A constant here would contradict that row the
   moment the feed serves a pre-0.7.0 release — a rollback, or a fork publishing
   unsigned builds, both of which RELEASE_REPOSITORY exists to allow. */
const macosSigning = channel?.targets.find((target) => target.platform === "macos")?.signing ?? null;
const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => localePath(bestLocaleFor(locale, path), path);
const c = locale === "en"
  ? {
      legend: "Choose platform and architecture",
      available: "Available",
      pending: "Verifying",
      detected: "Showing the platform that is currently downloadable; you can switch at any time.",
      primaryEyebrow: "Direct download",
      primaryCta: "Download now",
      mirrorNote: "Chinese-language browser detected — this download points at the Gitee mirror, the identical official build.",
      mirrorFallback: "Download from GitHub instead",
      historyNote: "Checksums, past versions and the full artifact list live on",
      notStableTitle: "This is not stable yet",
      notStableBody: macosSigning === "notarized"
        ? "The macOS build is Developer ID-signed and notarised by Apple, so the first launch opens normally. The Windows build carries no Authenticode signature yet, so SmartScreen warns once about an unknown publisher. Each platform reaches stable on its own once its signing and verification evidence are complete — until then, checksums for every artifact are published on GitHub Releases."
        : "This macOS build predates signing, so Gatekeeper blocks its first launch — prefer the newest release, whose macOS builds are signed and notarised from v0.7.0 on. Checksums are published on GitHub Releases. BootAgent never asks you to disable Gatekeeper or weaken your system-wide settings.",
      verified: "Verified and downloadable",
      channelLabel: "Release channel",
      size: "File size",
      built: "Build date",
      signing: "Signing status",
      /* Keyed by the per-target state the channel reports — signing diverged by
         platform at v0.7.0, so a single string would be wrong somewhere. */
      signingValue: {
        "notarized": "Developer ID + Apple notarisation",
        "signed": "Authenticode signed",
        "unsigned": "Unsigned",
        "not-applicable": "No OS signing gate",
      } as const,
      download: (platform: string) => `Download the ${platform} preview`,
      quickstart: "Read the quickstart",
      sameBuildTitle: "You get the verified official build",
      sameBuildBody: "Every channel — this site, GitHub Releases, any mirror — serves the identical official build. Repackaging is not permitted.",
      unavailableTitle: "This platform has no public release yet",
      unavailableBody: "The build workflow is in place, but until the native build, cleanroom evidence and release metadata are all present there is no empty download button and no CI artifact described as generally available.",
      progress: "See release progress",
      channelValue: "Technical preview",
      fallbackPlatform: "current platform",
      detectExact: "Detected as {full}. You can still switch manually.",
      detectArchOnly: "Detected as {name} {arch}, but there is no exact build for that architecture here — do not run a build for a mismatched architecture.",
      detectPlatformOnly: "Detected as {name}, but the browser cannot reliably tell the chip architecture. Confirm the option before downloading.",
    }
  : {
      legend: "选择平台与架构",
      available: "可下载",
      pending: "验证中",
      detected: "已优先显示当前可下载的平台；你可以随时手动切换。",
      primaryEyebrow: "直接下载",
      primaryCta: "立即下载",
      mirrorNote: "检测到中文浏览器环境，下载已指向国内镜像（Gitee，同一官方构建）。",
      mirrorFallback: "改从 GitHub 下载",
      historyNote: "校验值、历史版本与完整产物清单见",
      notStableTitle: "还不叫 Stable",
      notStableBody: macosSigning === "notarized"
        ? "macOS 版已由 Developer ID 签名并经 Apple 公证，首次打开不再被拦截。Windows 版尚未完成 Authenticode 签名，SmartScreen 会提示一次“未知发布者”。按 Stable 门禁，每个平台在签名与验证证据齐备后各自转正——在那之前，每个产物的校验值都随发行公布在 GitHub Releases。"
        : "这个 macOS 版本早于签名交付，首次打开会被 Gatekeeper 拦截——请优先使用最新版本，macOS 产物自 v0.7.0 起已签名并公证。校验值随发行公布在 GitHub Releases。BootAgent 不会要求你关闭 Gatekeeper 或降低系统整体安全设置。",
      verified: "已验证可下载",
      channelLabel: "发行渠道",
      size: "文件大小",
      built: "构建日期",
      signing: "签名状态",
      /* 与英文同理：v0.7.0 起签名状态按平台分化，单一字符串必然在某个平台上说错。 */
      signingValue: {
        "notarized": "Developer ID 签名 + Apple 公证",
        "signed": "Authenticode 签名",
        "unsigned": "未签名",
        "not-applicable": "平台无签名门禁",
      } as const,
      download: (platform: string) => `下载 ${platform} 预览版`,
      quickstart: "查看快速开始",
      sameBuildTitle: "下载即得到被校验的官方同包产物",
      sameBuildBody: "官网、GitHub Releases 与任何镜像渠道分发的都是同一个官方构建，禁止二次打包。",
      unavailableTitle: "这个平台尚未公开发行",
      unavailableBody: "构建工作流已经保留，但在原生构建、cleanroom 证据和发行元数据齐备前，不提供空下载按钮，也不把 CI 产物描述为正式可用。",
      progress: "查看发行进度",
      channelValue: "技术预览版",
      fallbackPlatform: "当前平台",
      detectExact: "已识别为 {full}；你仍可手动切换。",
      detectArchOnly: "已识别为 {name} {arch}，当前目录没有完全匹配的构建；请勿运行架构不匹配的包。",
      detectPlatformOnly: "已识别为 {name}，但浏览器无法可靠判断芯片架构；请确认选项后下载。",
    };
---
{!channel || !defaultTarget ? (
  <div class="notice notice-warning">
    <span class="notice-mark">!</span>
    <div>
      <strong>{c.unavailableTitle}</strong>
      <p>{c.unavailableBody}</p>
    </div>
  </div>
) : (
<div class="download-layout-wrap" data-download-selector>
{defaultDownload && defaultArtifact && (
  <div class="download-primary">
    <div>
      <p class="eyebrow">{c.primaryEyebrow}</p>
      <p class="download-primary-title">BootAgent<span class="download-primary-target" data-primary-target> · {defaultTarget!.platformLabel} {defaultTarget!.archLabel}</span></p>
      <p class="download-primary-meta"><span data-primary-size>{formatBytes(defaultArtifact.bytes)}</span> · <span data-primary-signing>{c.signingValue[defaultTarget!.signing]}</span></p>
    </div>
    {/* Named differently from the per-panel buttons on purpose: two links whose
        accessible names both match /下载 .* 预览版/ would trip every strict-mode
        locator in the e2e suite, and a reader scanning the page should see one
        primary action and one detailed panel, not the same button twice. */}
    <a class="button button-primary download-primary-button" data-primary-link data-cn-href={defaultMirror?.url} href={defaultDownload.url} download>{c.primaryCta}</a>
    {/* Revealed by the script only when the browser prefers Chinese AND the
        selected target is actually on the mirror — the mirror hosts a subset of
        the release (the macOS DMGs as of v0.7.2), so Windows and Linux keep
        GitHub even for Chinese-language browsers. */}
    <p class="download-mirror-note" data-mirror-note hidden>{c.mirrorNote} <a data-mirror-fallback href={defaultDownload.url} rel="noopener">{c.mirrorFallback}</a></p>
  </div>
)}
<div class="download-layout">
  <aside class="platform-control">
    <fieldset class="platform-picker" data-platform-picker>
      <legend>{c.legend}</legend>
      {channel.targets.map((target) => (
        <label class="platform-option">
          <input
            type="radio"
            name="platform-target"
            value={target.id}
            checked={target.id === defaultTarget.id}
            data-platform-radio
          />
          <span class="platform-option-body">
            <span class="platform-option-name">{target.platformLabel}</span>
            <span class="platform-option-arch">{target.archLabel}</span>
          </span>
          {target.status === "available"
            ? <span class="chip chip-green">{c.available}</span>
            : <span class="chip chip-orange">{c.pending}</span>}
        </label>
      ))}
    </fieldset>
    <p
      class="detected-note"
      data-detected-note
      data-detect-exact={c.detectExact}
      data-detect-arch={c.detectArchOnly}
      data-detect-platform={c.detectPlatformOnly}
      data-fallback={c.fallbackPlatform}
    >{c.detected}</p>
    <div class="notice notice-warning" style="margin-top:22px">
      <span class="notice-mark">!</span>
      <div>
        <strong>{c.notStableTitle}</strong>
        <p>{c.notStableBody}</p>
      </div>
    </div>
  </aside>

  <div>
    {channel.targets.map((target) => {
      const artifact = binaryArtifact(target);
      const download = artifact ? primaryDownload(artifact) : null;
      return (
        <section
          class:list={["release-panel", { "is-active": target.id === defaultTarget.id }]}
          data-release-panel={target.id}
          aria-hidden={target.id === defaultTarget.id ? "false" : "true"}
          data-download-url={download?.url}
          data-download-cn-url={artifact ? mirrorDownload(artifact)?.url : undefined}
          data-target-label={`${target.platformLabel} ${target.archLabel}`}
          data-size-label={artifact ? formatBytes(artifact.bytes) : undefined}
          data-signing-label={c.signingValue[target.signing]}
        >
          <div class="release-head">
            <div>
              <h2>{target.platformLabel}</h2>
              <p>{target.archLabel}</p>
            </div>
            {target.status === "available" ? <span class="chip chip-green">{c.verified}</span> : <span class="chip chip-orange">{c.pending}</span>}
          </div>

          {target.status === "available" && artifact && download ? (
            <>
              <dl class="release-meta-grid">
                <div><dt>{c.channelLabel}</dt><dd>{c.channelValue}</dd></div>
                <div><dt>{c.size}</dt><dd>{formatBytes(artifact.bytes)}</dd></div>
                <div><dt>{c.built}</dt><dd>{formatDate(target.built_at)}</dd></div>
                {/* Per-target: macOS is notarised from v0.7.0 while Windows is not,
                    so the value comes from the channel rather than a constant.

                    The row this replaced read "原生构建 + cleanroom 通过" for every
                    target unconditionally — a claim the GitHub feed cannot support
                    (it reports cleanroom as not-recorded), and exactly the kind of
                    badge the release-channel module exists to prevent. The SHA-256
                    block below is the verification a reader can actually run. */}
                <div><dt>{c.signing}</dt><dd>{c.signingValue[target.signing]}</dd></div>
              </dl>
              <div class="download-action">
                <a class="button button-primary" data-cn-href={artifact && mirrorDownload(artifact)?.url} href={download.url} download>{c.download(target.platformLabel)}</a>
                <a class="button button-secondary" href={href("quickstart/")}>{c.quickstart}</a>
              </div>
              <div class="notice notice-info">
                <span class="notice-mark">i</span>
                <div>
                  <strong>{c.sameBuildTitle}</strong>
                  <p>{c.sameBuildBody}</p>
                </div>
              </div>
              {/* The full digest and the verification command used to be printed
                  here. They are engineering material, and the page's own history
                  line points at GitHub Releases, which publishes SHA256SUMS with
                  every release — the reader who verifies gets the value from the
                  same feed the site would have copied it from. */}
            </>
          ) : (
            <div class="unavailable-panel">
              <h3>{c.unavailableTitle}</h3>
              <p>{c.unavailableBody}</p>
              <a class="button button-secondary" href={href("changelog/")}>{c.progress}</a>
            </div>
          )}
        </section>
      );
    })}
  </div>
</div>
<p class="download-history">{c.historyNote} <a href={releasesPageUrl} rel="noopener">GitHub Releases</a>{locale === "en" ? "." : "。"}</p>
</div>
)}

<script>
  import { detectTargetFromUserAgent } from "../lib/downloads";

  const root = document.querySelector<HTMLElement>("[data-download-selector]");
  const radios = root ? Array.from(root.querySelectorAll<HTMLInputElement>("[data-platform-radio]")) : [];
  const note = root?.querySelector<HTMLElement>("[data-detected-note]");
  const panels = root ? Array.from(root.querySelectorAll<HTMLElement>("[data-release-panel]")) : [];

  /* Keeps the primary block in step with the picker, reading the per-target
     values the server rendered onto each panel. A target with no artifact has
     no data-download-url, and the primary block hides rather than keep offering
     the previous target's file under the new target's name. */
  const primary = root?.querySelector<HTMLElement>(".download-primary");
  const primaryLink = primary?.querySelector<HTMLAnchorElement>("[data-primary-link]");
  const mirrorNote = primary?.querySelector<HTMLElement>("[data-mirror-note]");
  const mirrorFallback = primary?.querySelector<HTMLAnchorElement>("[data-mirror-fallback]");
  /* Browser language, not page language: a Chinese-language browser reading the
     English page still sits on a mainland network, and the page language says
     nothing about where the reader is downloading from. The swap only applies
     where the server emitted a data-cn-href — the mirror hosts a subset of the
     release, so unmirrored targets keep GitHub for everyone. */
  const prefersChinaMirror = (navigator.languages ?? [navigator.language])
    .some((language) => (language ?? "").toLowerCase().startsWith("zh"));
  const updatePrimary = (id: string) => {
    if (!primary || !primaryLink) return;
    const panel = panels.find((candidate) => candidate.dataset.releasePanel === id);
    const url = panel?.dataset.downloadUrl;
    primary.hidden = !url;
    if (!panel || !url) return;
    const mirrorUrl = prefersChinaMirror ? panel.dataset.downloadCnUrl : undefined;
    primaryLink.href = mirrorUrl ?? url;
    if (mirrorNote) {
      mirrorNote.hidden = !mirrorUrl;
      if (mirrorUrl && mirrorFallback) mirrorFallback.href = url;
    }
    const target = primary.querySelector("[data-primary-target]");
    if (target) target.textContent = ` · ${panel.dataset.targetLabel ?? ""}`;
    const size = primary.querySelector("[data-primary-size]");
    if (size) size.textContent = panel.dataset.sizeLabel ?? "";
    const signing = primary.querySelector("[data-primary-signing]");
    if (signing) signing.textContent = panel.dataset.signingLabel ?? "";
  };

  // The per-panel buttons swap once: their data-cn-href is per-file, so an
  // unmirrored file keeps its GitHub href untouched.
  if (prefersChinaMirror) {
    root?.querySelectorAll<HTMLAnchorElement>("a[data-cn-href]").forEach((link) => {
      const mirrorUrl = link.dataset.cnHref;
      if (mirrorUrl) link.href = mirrorUrl;
    });
    if (primaryLink) updatePrimary(panels.find((panel) => panel.classList.contains("is-active"))?.dataset.releasePanel ?? "");
  }

  const show = (id: string) => {
    panels.forEach((panel) => {
      const active = panel.dataset.releasePanel === id;
      panel.classList.toggle("is-active", active);
      panel.setAttribute("aria-hidden", active ? "false" : "true");
    });
    updatePrimary(id);
  };

  // The detection notes are localised templates passed from the server through
  // data attributes, so an English reader never sees the Chinese fallback that a
  // hardcoded string would leave behind. {full}/{name}/{arch} are filled client-
  // side because the platform name only exists in the rendered DOM.
  const tplExact = note?.dataset.detectExact ?? "";
  const tplArch = note?.dataset.detectArch ?? "";
  const tplPlatform = note?.dataset.detectPlatform ?? "";
  const fallbackPlatform = note?.dataset.fallback ?? "";
  const fill = (template: string, vars: Record<string, string>) =>
    template.replace(/\{(\w+)\}/g, (_, key: string) => vars[key] ?? "");

  const labelFor = (radio: HTMLInputElement) => {
    const name = radio.parentElement?.querySelector(".platform-option-name")?.textContent?.trim() ?? fallbackPlatform;
    const arch = radio.parentElement?.querySelector(".platform-option-arch")?.textContent?.trim() ?? "";
    return { name, full: arch ? `${name} · ${arch}` : name };
  };

  if (radios.length) {
    const detected = detectTargetFromUserAgent(navigator.userAgent);
    if (detected) {
      const exact = radios.find((radio) => radio.value === `${detected.platform}-${detected.arch}`);
      const samePlatform = radios.find((radio) => radio.value.startsWith(`${detected.platform}-`));
      const match = exact ?? samePlatform;
      if (match) {
        match.checked = true;
        show(match.value);
        if (note) {
          const { name, full } = labelFor(match);
          if (exact) note.textContent = fill(tplExact, { full, name });
          else if (detected.arch) {
            const architecture = detected.arch === "arm64" ? "ARM64" : "x64";
            note.textContent = fill(tplArch, { name, arch: architecture });
          } else {
            note.textContent = fill(tplPlatform, { name });
          }
        }
      }
    }
    // Radio groups fire change on the newly selected input, and arrow-key
    // navigation moves selection too, so one listener per input covers both
    // pointer and keyboard without any roving-tabindex bookkeeping.
    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        if (radio.checked) show(radio.value);
      });
    });
  }
</script>
