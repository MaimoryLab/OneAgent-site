---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LocaleSwitch from "./LocaleSwitch.astro";
import GitHubStars from "./GitHubStars.astro";
import { repositoryUrl } from "../lib/downloads";
import { bestLocaleFor, localeFromPath, localePath, routeWithoutLocale, switchesLanguage } from "../i18n";
import { useTranslations } from "../i18n/ui";

const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
const t = useTranslations(locale);
const href = (path: string) => localePath(bestLocaleFor(locale, path), path);
/* The security and enterprise pages stay published and linked from the footer,
   the release index and the demo's preview-gate result — they are just not
   worth a top-level nav slot. */
const nav = [
  { path: "downloads/", label: t("nav.downloads") },
  { path: "quickstart/", label: t("nav.quickstart") },
  { path: "explore/", label: t("nav.explorer") },
];
// Compared on the locale-stripped route so /en/agents/ marks the same item as
// /agents/ rather than matching on a substring of the full path.
const route = routeWithoutLocale(pathname);
const active = (path: string) =>
  route === path ||
  (path === "explore/" && (route === "agents/" || route.startsWith("agents/") || route === "providers/" || route.startsWith("providers/")));
---
{/* Watched by the script below to tell "at the top" from "content is passing
    underneath". A zero-height element before the header costs no layout and lets
    an IntersectionObserver answer the question without a scroll listener firing
    on every frame. */}
<div data-scroll-sentinel aria-hidden="true"></div>
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={href("")} aria-label={t("nav.home")}>
      <span class="wordmark-mark"><BrandMark size={26} /></span>
      <span>BootAgent</span>
    </a>
    <nav class="desktop-nav" aria-label={t("nav.primary")}>
      {nav.map((item) => (
        <a href={href(item.path)} aria-current={active(item.path) ? "page" : undefined}>
          {item.label}
          {switchesLanguage(locale, item.path) && <span class="lang-hint">{t("nav.chineseOnly")}</span>}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      {/* Before the locale and theme controls: it is a destination, where those
          two are settings for the current page. Carries .header-link, so it hides
          with the desktop nav below 920px and reappears in the mobile menu. */}
      <GitHubStars />
      <LocaleSwitch />
      <ThemeToggle />
      <a class:list={["button", "button-small", route === "" ? "button-secondary" : "button-primary"]} href={href("downloads/")}>{t("cta.download")}</a>
      <details class="mobile-menu">
        <summary aria-label={t("nav.openMenu")}>{t("nav.menu")}</summary>
        <nav aria-label={t("nav.mobile")}>
          {[...nav, { path: "support/", label: t("nav.support") }].map((item) => (
            <a href={href(item.path)}>
              {item.label}
              {switchesLanguage(locale, item.path) && <span class="lang-hint">{t("nav.chineseOnly")}</span>}
            </a>
          ))}
          {/* The header copy is hidden at this width, so the repository would be
              unreachable from the chrome on a phone without this. Text rather than
              a count: the menu is a list of destinations. */}
          <a href={repositoryUrl} rel="noopener">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>
{/* The scroll edge lives outside the header rather than as its ::after: axe cannot
    resolve the background of a text node whose ancestor has a pseudo-element, so an
    ::after here made every header link's contrast unprovable. */}
<div class="scroll-edge" aria-hidden="true"></div>

<script>
  /* Flags the header once content is scrolling underneath it, so the scroll edge
     in global.css can appear only when there is something to separate from.
     Purely presentational: with no JS the header keeps its resting state, which is
     the correct-looking one at the top of every page.

     An IntersectionObserver on a sentinel rather than a scroll listener — the
     browser reports the two states directly instead of us recomputing a threshold
     on every frame. */
  const sentinel = document.querySelector("[data-scroll-sentinel]");
  const header = document.querySelector(".site-header");
  if (sentinel && header) {
    new IntersectionObserver(
      ([entry]) => {
        header.toggleAttribute("data-scrolled", !entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>
