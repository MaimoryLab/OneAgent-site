---
import AgentMark from "./AgentMark.astro";
import BrandMark from "./BrandMark.astro";
import { bestLocaleFor, localeFromPath, localePath, switchesLanguage } from "../i18n";
import { useCatalogLabels } from "../i18n/catalog";
import { catalog } from "../lib/catalog";
import { protocolLabels } from "../lib/content";
import {
  activationDemo,
  demoAgentStateFor,
  demoAgentsForTab,
  demoModelsFor,
  localizedDemoLabel,
  type DemoLocale,
} from "../lib/demo-environment";

interface Props {
  id?: string;
}

const { id = "activation-console" } = Astro.props;
const locale = localeFromPath(Astro.url.pathname) as DemoLocale;
const scenario = activationDemo.scenario;
const desktopAgents = demoAgentsForTab("desktop");
const cliAgents = demoAgentsForTab("cli");
const models = demoModelsFor(scenario);
const providerOptions = catalog.providers.filter((provider) =>
  scenario.selectedAgent.protocol === "anthropic" ? Boolean(provider.anthropicBaseUrl) : Boolean(provider.baseUrl),
);
const navItems = activationDemo.navigation.map((item) => ({ ...item, label: localizedDemoLabel(item, locale) }));
const utilityItems = activationDemo.utilityNavigation.map((item) => ({ ...item, label: localizedDemoLabel(item, locale) }));
const steps = activationDemo.steps.map((step) => ({ ...step, label: localizedDemoLabel(step, locale) }));
const existingProfileLabel = localizedDemoLabel({ labels: scenario.existingProfile.labels }, locale);
const newProfileLabel = localizedDemoLabel({ labels: scenario.newProfileLabels }, locale);
const href = (path: string) => localePath(bestLocaleFor(locale, path), path);
const providerCatalogSwitchesLanguage = switchesLanguage(locale, "providers/");
const providerCatalogLanguageLabel = locale === "en" ? "Chinese catalogue" : "中文目录";
const { agentDescriptions, agentFallbackDescription } = useCatalogLabels(locale);
const selectedProtocol = scenario.selectedAgent.protocol ? protocolLabels[scenario.selectedAgent.protocol] : "";
const installCommand = scenario.selectedAgent.packageManager && scenario.selectedAgent.packageName
  ? `$ ${scenario.selectedAgent.packageManager} install -g --registry=${scenario.registry} ${scenario.selectedAgent.packageName}`
  : `$ ${scenario.selectedAgent.command ?? scenario.selectedAgent.id} --version`;
const versionCommand = `$ ${scenario.selectedAgent.command ?? scenario.selectedAgent.id} --version`;

const copy = locale === "en"
  ? {
      sample: "Demo environment",
      source: `UI path pinned to ${activationDemo.source.release}`,
      brandSubtitle: "Agent Manager",
      workspace: "Workspace",
      noDevice: "No device access",
      noKey: "No API key field",
      noNetwork: "No activation request",
      replay: "Replay demo",
      releaseNote: "Deterministic example · no local scan",
      agentTitle: "Select agents",
      agentDescription: "Choose the development tool to install and configure. One per run",
      agentBodyTitle: "Select agents",
      desktopTab: "Desktop Agent",
      cliTab: "Command-line Agent",
      desktopBody: "Install the official desktop application",
      cliBody: "Detection, installation and initial configuration",
      installed: "Installed",
      notInstalled: "Not installed",
      mirror: "Agent install source",
      mirrorBody: "A mirror is the default here based on the example system region. You can switch back to the official source",
      chooseAgent: "Select one agent",
      continue: "Continue",
      back: "Back",
      profileTitle: "Select a profile",
      profileDescription: "Choose an existing profile, or create a new profile",
      newProfile: "Create new profile",
      providerTitle: "Connect a Provider",
      providerDescription: "The Provider's saved key will be used",
      providerLabel: "Provider",
      addProvider: "Add Provider",
      getKey: "Get API key",
      modelsFound: `Found ${models.length} models`,
      probeModel: "Test model (optional)",
      probePlaceholder: "Search models",
      probeHint: "Only tests whether this Provider is reachable. It does not configure anything. Choose the real model on the next step",
      testConnection: "Test connection",
      connectionIdle: "Connection not tested",
      connectionLoading: "Validating endpoint and key",
      connectionSuccess: `${selectedProtocol} connection test passed.`,
      connectionError: "The example connection failed. You can still continue or retry.",
      optionalProbe: "Connection testing is optional. You can continue directly to model selection",
      continueModels: "Continue to model selection",
      modelTitle: "Select a model",
      modelDescription: "Choose from models available to the current key, or type a model ID when discovery is unavailable",
      modelNotice: `Found ${models.length} models`,
      modelInput: "Enter model ID manually",
      refresh: "Refresh list",
      reviewTitle: "Review activation",
      reviewDescription: "Review install, configuration and backup scope. The API key is not shown here",
      willProcess: "Will process",
      installAndConfigure: "Install and configure",
      detectAndConfigure: "Detect and configure",
      providerGroup: "Provider",
      providerRow: "Provider",
      modelRow: "Model",
      localWrites: "Local writes",
      environmentSummary: "Environment summary",
      profileName: "Profile name",
      profileHint: "This installation will be saved as a profile that can be applied later",
      backup: "A timestamped backup is created before overwrite",
      startInstall: "Start installing",
      installing: "Installing",
      installComplete: "Installation complete",
      installCancelled: "Cancelled",
      installFailure: "Some items need attention",
      installDescription: "Each Agent has an independent result. Failed items can be handled separately",
      keepOpen: "Keep this window open",
      installLog: "View install log",
      cancelTask: "Cancel task",
      closeTask: "Close task",
      enterOverview: "Open overview",
      taskStatusRunning: "In progress",
      taskStatusSuccess: "Complete · Installation complete",
      taskStatusCancelled: "Cancelled",
      taskStatusFailure: "Failed",
      overviewTitle: "Environment overview",
      overviewDescription: "Installed Agents and their current configuration on this machine",
      cliSection: "Command-line Agent",
      desktopSection: "Desktop Agent",
      countOne: "1 total",
      countZero: "0 total",
      details: "Details",
      update: "Update",
      configure: "Configure",
      launch: "Launch",
      installAgent: "Install Agent",
      refreshStatus: "Refresh status",
      emptyDesktop: "Install a desktop Agent from the guided flow",
      launchNote: "The website demo does not open a local terminal.",
      taskReturn: "Return to task page",
      dismiss: "Dismiss",
    }
  : {
      sample: "示例环境",
      source: `界面路径固定为 ${activationDemo.source.release}`,
      brandSubtitle: "Agent 管家",
      workspace: "工作区",
      noDevice: "不访问设备",
      noKey: "不提供 Key 输入框",
      noNetwork: "不发送激活请求",
      replay: "重放演示",
      releaseNote: "确定性示例 · 不扫描本机",
      agentTitle: "选择 Agent",
      agentDescription: "选择这次要安装并配置的开发工具，每次安装一个",
      agentBodyTitle: "选择 Agent",
      desktopTab: "桌面 Agent",
      cliTab: "命令行 Agent",
      desktopBody: "安装官方桌面应用",
      cliBody: "支持检测、安装与初始化配置",
      installed: "已安装",
      notInstalled: "待安装",
      mirror: "Agent 安装源",
      mirrorBody: "已根据示例系统地区设置默认使用镜像。可以改回官方源",
      chooseAgent: "选择一个 Agent",
      continue: "继续",
      back: "返回",
      profileTitle: "选择配置模版",
      profileDescription: "选择一个已有配置模版，或新建配置模版",
      newProfile: "新建配置模版",
      providerTitle: "连接模型服务",
      providerDescription: "将使用模型服务已保存的 Key",
      providerLabel: "模型服务",
      addProvider: "新增模型服务",
      getKey: "获取 API Key",
      modelsFound: `找到 ${models.length} 个模型`,
      probeModel: "测试用模型（可选）",
      probePlaceholder: "搜索模型",
      probeHint: "仅用于测试这个模型服务是否连得通，不会写入任何配置。真正使用的模型在下一步选择",
      testConnection: "测试连接",
      connectionIdle: "尚未测试连接",
      connectionLoading: "正在验证端点和 Key",
      connectionSuccess: `${selectedProtocol} connection test passed.`,
      connectionError: "示例连接失败，可以直接继续或重新测试。",
      optionalProbe: "连接测试是可选的，可以直接继续选择模型",
      continueModels: "继续选择模型",
      modelTitle: "选择模型",
      modelDescription: "从当前 Key 可访问的模型中选择，接口不支持时可直接输入模型 ID",
      modelNotice: `找到 ${models.length} 个模型`,
      modelInput: "手动输入模型 ID",
      refresh: "刷新列表",
      reviewTitle: "确认激活",
      reviewDescription: "核对安装、配置和备份范围。API Key 不会显示在此页",
      willProcess: "将处理",
      installAndConfigure: "安装并配置",
      detectAndConfigure: "检测并配置",
      providerGroup: "模型服务",
      providerRow: "模型服务",
      modelRow: "模型",
      localWrites: "本地写入",
      environmentSummary: "环境摘要",
      profileName: "配置模版名称",
      profileHint: "这次安装会保存为一个配置模版，之后可以直接应用",
      backup: "覆盖前会自动创建时间戳备份",
      startInstall: "开始安装",
      installing: "正在安装",
      installComplete: "安装完成",
      installCancelled: "已取消",
      installFailure: "需要处理部分问题",
      installDescription: "每个 Agent 的结果彼此独立，失败项可以单独处理",
      keepOpen: "请保持此窗口打开",
      installLog: "查看安装日志",
      cancelTask: "取消任务",
      closeTask: "关闭任务",
      enterOverview: "进入总览",
      taskStatusRunning: "进行中",
      taskStatusSuccess: "已完成 · 安装完成",
      taskStatusCancelled: "已取消",
      taskStatusFailure: "失败",
      overviewTitle: "环境总览",
      overviewDescription: "本机已安装 Agent 及其当前配置",
      cliSection: "命令行 Agent",
      desktopSection: "桌面 Agent",
      countOne: "共 1 个",
      countZero: "共 0 个",
      details: "详情",
      update: "更新",
      configure: "配置",
      launch: "启动",
      installAgent: "安装 Agent",
      refreshStatus: "刷新状态",
      emptyDesktop: "按引导安装桌面 Agent",
      launchNote: "网站演示不会打开本机终端。",
      taskReturn: "返回任务页面",
      dismiss: "关闭",
    };
---
<div class="product-shot activation-shell">
  <div class="activation-demo-caption" aria-label={copy.sample}>
    <span><i aria-hidden="true"></i>{copy.sample}</span>
    <span>{copy.source} · {activationDemo.source.commit.slice(0, 7)}</span>
  </div>

  <activation-console
    id={id}
    data-locale={locale}
    data-screen="agents"
    data-phase="agents"
    data-route="/setup/agents"
    data-source-release={activationDemo.source.release}
  >
    <div class="activation-window" data-console-window tabindex="-1">
      <aside class="activation-sidebar" aria-label={copy.workspace}>
        <div class="activation-brand">
          <span class="activation-brand-mark" aria-hidden="true"><BrandMark size={28} /></span>
          <span><strong>BootAgent</strong><small>{copy.brandSubtitle}</small></span>
        </div>
        <p class="activation-nav-label">{copy.workspace}</p>
        <nav class="activation-nav" aria-label={copy.workspace}>
          {navItems.map((item) => (
            <span class="activation-nav-item" data-nav-id={item.id}>
              <span aria-hidden="true" class={`nav-icon nav-icon-${item.id}`}></span>
              {item.label}
            </span>
          ))}
        </nav>
        <div class="activation-sidebar-bottom">
          <button class="activation-task-trigger" type="button" data-task-trigger data-utility-id="tasks" aria-expanded="false">
            <span aria-hidden="true" class="nav-icon nav-icon-tasks"></span>
            <span>{utilityItems.find((item) => item.id === "tasks")?.label}</span>
            <span class="activation-disclosure-icon" aria-hidden="true"></span>
          </button>
          <span class="activation-settings-row" data-utility-id="settings">
            <span aria-hidden="true" class="nav-icon nav-icon-settings"></span>
            {utilityItems.find((item) => item.id === "settings")?.label}
          </span>
        </div>
      </aside>

      <div class="activation-workspace">
        <main class="activation-main">
          <header class="activation-page-header">
            <div class="activation-page-heading">
              <h2 data-page-title>{copy.agentTitle}</h2>
              <p data-page-description>{copy.agentDescription}</p>
            </div>
            <ol class="activation-stepper" data-stepper aria-label={locale === "en" ? "Activation steps" : "激活步骤"}>
              {steps.map((step, index) => (
                <li data-step-id={step.id} data-presentation={index === 0 ? "current" : "upcoming"}>
                  <span class="activation-step-marker"><span data-step-number>{index + 1}</span><span data-step-check aria-hidden="true"></span></span>
                  <span class="activation-step-label">{step.label}</span>
                  <span class="activation-step-line" aria-hidden="true"></span>
                </li>
              ))}
            </ol>
          </header>

          <div class="activation-page-body">
            <section
              class="activation-panel activation-agent-panel"
              data-panel="agents"
              data-page-title={copy.agentTitle}
              data-page-description={copy.agentDescription}
              tabindex="-1"
            >
              <div class="activation-body-heading">
                <h3>{copy.agentBodyTitle}</h3>
                <p>{copy.agentDescription}</p>
              </div>
              <div class="activation-agent-tabs" role="tablist" aria-label={locale === "en" ? "Agent type" : "Agent 类型"}>
                <button type="button" role="tab" data-agent-tab="desktop" aria-selected="true">{copy.desktopTab}</button>
                <button type="button" role="tab" data-agent-tab="cli" aria-selected="false">{copy.cliTab}</button>
              </div>
              <div class="activation-agent-list" data-agent-list="desktop" role="tabpanel">
                {desktopAgents.map((agent) => {
                  const state = demoAgentStateFor(agent.id);
                  return (
                    <label class="activation-agent-row" data-agent-id={agent.id} data-agent-kind="desktop">
                      <input type="radio" name={`${id}-agent`} value={agent.id} aria-label={`${locale === "en" ? "Select" : "选择"} ${agent.name}`} />
                      <AgentMark id={agent.id} name={agent.name} size={27} />
                      <span class="activation-agent-copy">
                        <strong>{agent.name}</strong>
                        <small title={agentDescriptions[agent.id] ?? agentFallbackDescription}>{copy.desktopBody}</small>
                      </span>
                      <span class:list={["activation-status-badge", { "is-installed": state.installed }]}>{state.installed ? copy.installed : copy.notInstalled}</span>
                    </label>
                  );
                })}
              </div>
              <div class="activation-agent-list" data-agent-list="cli" role="tabpanel" hidden>
                {cliAgents.map((agent) => {
                  const state = demoAgentStateFor(agent.id);
                  return (
                    <label class="activation-agent-row" data-agent-id={agent.id} data-agent-kind="cli">
                      <input type="radio" name={`${id}-agent`} value={agent.id} aria-label={`${locale === "en" ? "Select" : "选择"} ${agent.name}`} />
                      <AgentMark id={agent.id} name={agent.name} size={27} />
                      <span class="activation-agent-copy">
                        <strong>{agent.name}</strong>
                        <small title={agentDescriptions[agent.id] ?? agentFallbackDescription}>{copy.cliBody}</small>
                      </span>
                      <span class:list={["activation-status-badge", { "is-installed": state.installed }]}>{state.installed ? copy.installed : copy.notInstalled}</span>
                    </label>
                  );
                })}
              </div>
              <details class="activation-mirror">
                <summary>{copy.mirror}</summary>
                <p>{copy.mirrorBody}</p>
              </details>
            </section>

            <section
              class="activation-panel activation-profile-panel"
              data-panel="profile"
              data-page-title={copy.profileTitle}
              data-page-description={copy.profileDescription}
              tabindex="-1"
              hidden
            >
              <article class="activation-profile-card is-selected">
                <label>
                  <input type="radio" name={`${id}-profile`} checked aria-label={`${locale === "en" ? "Select" : "选择"} ${existingProfileLabel}`} />
                  <span><strong>{existingProfileLabel}</strong><small>{scenario.existingProfile.id}</small></span>
                  <span aria-hidden="true">✓</span>
                </label>
                <p>{scenario.provider.name} · {scenario.existingProfile.model}</p>
              </article>
            </section>

            <section
              class="activation-panel activation-provider-panel"
              data-panel="provider"
              data-page-title={copy.providerTitle}
              data-page-description={copy.providerDescription}
              tabindex="-1"
              hidden
            >
              <div class="activation-field-stack">
                <label id={`${id}-provider-label`}>{copy.providerLabel}</label>
                <div class="activation-provider-picker">
                  <button
                    class="activation-select-trigger"
                    type="button"
                    role="combobox"
                    aria-labelledby={`${id}-provider-label`}
                    aria-controls={`${id}-provider-options`}
                    aria-expanded="false"
                    data-provider-trigger
                  >
                    <span data-provider-name>{scenario.provider.name}</span><span class="activation-disclosure-icon" aria-hidden="true"></span>
                  </button>
                  <div class="activation-select-options" id={`${id}-provider-options`} role="listbox" aria-label={copy.providerLabel} data-provider-options hidden>
                    {providerOptions.map((provider) => (
                      <button type="button" role="option" data-provider-id={provider.id} aria-selected={provider.id === scenario.provider.id}>{provider.name}</button>
                    ))}
                  </div>
                  <a
                    class="activation-icon-link"
                    href={href("providers/")}
                    aria-label={`${copy.addProvider}${providerCatalogSwitchesLanguage ? ` · ${providerCatalogLanguageLabel}` : ""}`}
                    title={`${copy.addProvider}${providerCatalogSwitchesLanguage ? ` · ${providerCatalogLanguageLabel}` : ""}`}
                  >
                    +
                    {providerCatalogSwitchesLanguage && <span class="lang-hint activation-language-hint" aria-hidden="true">中</span>}
                  </a>
                </div>
              </div>

              <div class="activation-provider-summary">
                <div><strong data-provider-summary-name>{scenario.provider.name}</strong><span data-provider-summary-url>{scenario.provider.baseUrl}</span></div>
                <a href={scenario.provider.keyManagementUrl} target="_blank" rel="noopener noreferrer">↗ {copy.getKey}</a>
              </div>

              <div class="activation-notice is-success" data-model-count>{copy.modelsFound}</div>

              <div class="activation-field-stack">
                <label for={`${id}-probe-model`}>{copy.probeModel}</label>
                <input id={`${id}-probe-model`} type="text" data-probe-input placeholder={copy.probePlaceholder} autocomplete="off" spellcheck="false" />
                <small>{copy.probeHint}</small>
              </div>

              <div class="activation-connection-row">
                <button class="activation-button is-secondary" type="button" data-test-connection>{copy.testConnection}</button>
                <div class="activation-inline-status" data-probe-status="idle" aria-live="polite">
                  <span data-probe-copy="idle">◉ {copy.connectionIdle}</span>
                  <span data-probe-copy="loading" hidden>◌ {copy.connectionLoading}</span>
                  <span data-probe-copy="success" hidden>✓ {copy.connectionSuccess}</span>
                  <span data-probe-copy="error" hidden>! {copy.connectionError}</span>
                </div>
              </div>
              <p class="activation-optional-note">{copy.optionalProbe}</p>
            </section>

            <section
              class="activation-panel activation-model-panel"
              data-panel="model"
              data-page-title={copy.modelTitle}
              data-page-description={copy.modelDescription}
              tabindex="-1"
              hidden
            >
              <div class="activation-notice is-success">{copy.modelNotice}</div>
              <div class="activation-field-stack">
                <label for={`${id}-model-id`}>{copy.modelInput}</label>
                <input id={`${id}-model-id`} type="text" data-model-input value={scenario.provider.defaultModel} autocomplete="off" spellcheck="false" />
              </div>
              <div class="activation-model-list" role="radiogroup" aria-label={copy.modelTitle}>
                {models.map((model) => (
                  <button type="button" role="radio" aria-checked={model === scenario.provider.defaultModel} data-model-id={model}>
                    <strong>{model}</strong><small>OpenAI-compatible model</small>
                  </button>
                ))}
              </div>
            </section>

            <section
              class="activation-panel activation-review-panel"
              data-panel="review"
              data-page-title={copy.reviewTitle}
              data-page-description={copy.reviewDescription}
              tabindex="-1"
              hidden
            >
              <div class="activation-review-group">
                <h3>{copy.willProcess}</h3>
                <div class="activation-review-row"><span>✓</span><span>{scenario.selectedAgent.name}</span><strong>{copy.installAndConfigure}</strong></div>
              </div>
              <div class="activation-review-group">
                <h3>{copy.providerGroup}</h3>
                <div class="activation-review-row"><span>✓</span><span>{copy.providerRow}</span><strong data-review-provider>{scenario.provider.name}</strong></div>
                <div class="activation-review-row"><span>✓</span><span>{copy.modelRow}</span><strong data-review-model>{scenario.provider.defaultModel}</strong></div>
                <div class="activation-review-row"><span>✓</span><span>Base URL</span><strong data-review-base>{scenario.provider.baseUrl}</strong></div>
              </div>
              <div class="activation-review-group">
                <h3>{copy.localWrites}</h3>
                <div class="activation-review-row"><span>✓</span><span>{scenario.selectedAgent.name}</span><strong>{scenario.paths.agentConfig}</strong></div>
                <div class="activation-review-row"><span>✓</span><span>{copy.environmentSummary}</span><strong>{scenario.paths.environmentSummary}</strong></div>
              </div>
              <div class="activation-field-stack activation-profile-name" data-new-profile-field>
                <label for={`${id}-profile-label`}>{copy.profileName}</label>
                <input id={`${id}-profile-label`} type="text" data-profile-label value={newProfileLabel} autocomplete="off" spellcheck="false" />
                <small>{copy.profileHint}</small>
              </div>
            </section>

            <section
              class="activation-panel activation-install-panel"
              data-panel="install"
              data-page-title-running={copy.installing}
              data-page-title-success={copy.installComplete}
              data-page-title-cancelled={copy.installCancelled}
              data-page-title-failure={copy.installFailure}
              data-page-description={copy.installDescription}
              tabindex="-1"
              hidden
            >
              <div class="activation-download-progress" data-install-progress>
                <div><span>{scenario.selectedAgent.name}</span><strong data-progress-percent>68%</strong></div>
                <span class="activation-progress-track"><span></span></span>
              </div>
              <details class="activation-install-log" open>
                <summary>{copy.installLog}</summary>
                <pre>{`${installCommand}\n${versionCommand}`}</pre>
              </details>
              <button class="activation-button is-secondary" type="button" data-cancel-task>{copy.cancelTask}</button>
              <button class="activation-button is-secondary" type="button" data-close-task hidden>{copy.closeTask}</button>
            </section>

            <section
              class="activation-panel activation-overview-panel"
              data-panel="overview"
              data-page-title={copy.overviewTitle}
              data-page-description={copy.overviewDescription}
              tabindex="-1"
              hidden
            >
              <section class="activation-overview-section">
                <header><div><h3>{copy.cliSection}</h3><span>{copy.countOne}</span></div></header>
                <article class="activation-managed-agent">
                  <div class="activation-managed-heading">
                    <AgentMark id={scenario.selectedAgent.id} name={scenario.selectedAgent.name} size={25} />
                    <strong>{scenario.selectedAgent.name}</strong>
                    <div class="activation-managed-tags">
                      <span data-overview-profile>{newProfileLabel}</span>
                      <span>● {scenario.provider.name}</span>
                      <span data-overview-model>{scenario.provider.defaultModel}</span>
                      <span>{scenario.installedVersion}</span>
                    </div>
                  </div>
                  <div class="activation-managed-actions">
                    <button type="button" class="activation-detail-button">{copy.details} ＋</button>
                    <span>
                      <button type="button" class="activation-button is-secondary">↻ {copy.update}</button>
                      <button type="button" class="activation-button is-secondary">☷ {copy.configure}</button>
                      <button type="button" class="activation-button is-primary" data-launch-agent>▷ {copy.launch}</button>
                    </span>
                  </div>
                </article>
              </section>
              <section class="activation-overview-section activation-empty-desktop">
                <header><div><h3>{copy.desktopSection}</h3><span>{copy.countZero}</span></div></header>
                <div><span aria-hidden="true">▢</span><p>{copy.emptyDesktop}</p></div>
              </section>
              <p class="activation-launch-note" data-launch-note hidden>{copy.launchNote}</p>
            </section>
          </div>
        </main>

        <footer class="activation-page-footer">
          <div class="activation-footer-screen" data-footer-screen="agents">
            <span data-agent-footer-note data-idle={copy.chooseAgent}>{copy.chooseAgent}</span>
            <button class="activation-button is-primary" type="button" data-action="continue-agents" disabled>{copy.continue} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="profile" hidden>
            <button class="activation-button is-secondary" type="button" data-action="back">← {copy.back}</button>
            <span class="activation-footer-spacer"></span>
            <button class="activation-button is-secondary" type="button" data-action="start-new-profile">＋ {copy.newProfile}</button>
            <button class="activation-button is-primary" type="button" data-action="reuse-profile">{copy.continue} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="provider" hidden>
            <button class="activation-button is-secondary" type="button" data-action="back">← {copy.back}</button>
            <span class="activation-route-note"><span aria-hidden="true">↗</span><span data-provider-footer>{scenario.provider.baseUrl} · {selectedProtocol}</span></span>
            <button class="activation-button is-primary" type="button" data-action="continue-provider">{copy.continueModels} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="model" hidden>
            <button class="activation-button is-secondary" type="button" data-action="back">← {copy.back}</button>
            <span class="activation-footer-spacer"></span>
            <button class="activation-button is-secondary" type="button" data-action="refresh-models">↻ {copy.refresh}</button>
            <button class="activation-button is-primary" type="button" data-action="continue-model">{copy.continue} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="review" hidden>
            <button class="activation-button is-secondary" type="button" data-action="back">← {copy.back}</button>
            <span class="activation-route-note">♢ {copy.backup}</span>
            <button class="activation-button is-primary" type="button" data-action="start-install">{copy.startInstall} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="install" hidden>
            <span data-install-footer-note>{copy.keepOpen}</span>
            <span class="activation-footer-spacer"></span>
            <button class="activation-button is-primary" type="button" data-action="enter-overview">{copy.enterOverview} →</button>
          </div>
          <div class="activation-footer-screen" data-footer-screen="overview" hidden>
            <span class="activation-footer-spacer"></span>
            <button class="activation-button is-secondary" type="button">↻ {copy.refreshStatus}</button>
            <button class="activation-button is-primary" type="button" data-action="replay">＋ {copy.installAgent}</button>
          </div>
        </footer>
      </div>

      <aside class="activation-task-popover" data-task-popover hidden aria-live="polite">
        <article>
          <span class="activation-task-state" data-task-state>◌</span>
          <button type="button" data-open-task aria-label={`${copy.taskReturn}: ${scenario.selectedAgent.name}`}>
            <strong>{locale === "en" ? `Install ${scenario.selectedAgent.name}` : `安装 ${scenario.selectedAgent.name}`}</strong>
            <small data-task-status>{copy.taskStatusRunning}</small>
          </button>
          <button type="button" data-dismiss-task aria-label={copy.dismiss}>×</button>
        </article>
      </aside>
    </div>
  </activation-console>

  <div class="activation-demo-footer">
    <span>{copy.releaseNote}</span>
    <button type="button" data-reset>{copy.replay}</button>
  </div>
  <footer class="activation-facts" aria-label={locale === "en" ? "Demo boundaries" : "演示边界"}>
    <span><i aria-hidden="true"></i>{copy.noDevice}</span>
    <span><i aria-hidden="true"></i>{copy.noKey}</span>
    <span><i aria-hidden="true"></i>{copy.noNetwork}</span>
  </footer>
</div>

<script>
  import { catalog } from "../lib/catalog";
  import {
    activationReducer,
    initialActivationState,
    routeForScreen,
    stepPresentation,
    type ActivationAction,
    type ActivationState,
  } from "../lib/activation";
  import { activationDemo, type DemoLocale } from "../lib/demo-environment";

  const scenario = activationDemo.scenario;

  type AutoplayStep = { delay: number; run: (element: ActivationConsoleElement) => void };
  const AUTOPLAY_SCRIPT: AutoplayStep[] = [
    { delay: 1000, run: (element) => element.selectAgentTab(scenario.autoplayAgentTab) },
    { delay: 2300, run: (element) => element.selectAgent(scenario.selectedAgent.id) },
    { delay: 1700, run: (element) => element.performAction("continue-agents") },
    { delay: 2200, run: (element) => element.performAction("start-new-profile") },
    { delay: 2200, run: (element) => element.startProbe() },
    { delay: 1900, run: (element) => element.performAction("continue-provider") },
    { delay: 2300, run: (element) => element.selectModel(scenario.provider.defaultModel) },
    { delay: 1800, run: (element) => element.performAction("continue-model") },
    { delay: 3000, run: (element) => element.performAction("start-install") },
    { delay: 3500, run: (element) => element.performAction("enter-overview") },
  ];

  const runtimeCopy = {
    "zh-CN": {
      taskRunning: "进行中",
      taskSuccess: "已完成 · 安装完成",
      taskCancelled: "已取消",
      taskFailure: "失败",
      installing: "正在安装",
      success: "安装完成",
      cancelled: "已取消",
      failure: "需要处理部分问题",
      installDescription: "每个 Agent 的结果彼此独立，失败项可以单独处理",
      keepOpen: "请保持此窗口打开",
      finished: "安装完成",
    },
    en: {
      taskRunning: "In progress",
      taskSuccess: "Complete · Installation complete",
      taskCancelled: "Cancelled",
      taskFailure: "Failed",
      installing: "Installing",
      success: "Installation complete",
      cancelled: "Cancelled",
      failure: "Some items need attention",
      installDescription: "Each Agent has an independent result. Failed items can be handled separately",
      keepOpen: "Keep this window open",
      finished: "Installation complete",
    },
  } as const;

  class ActivationConsoleElement extends HTMLElement {
    state: ActivationState = initialActivationState(scenario);
    autoplaying = false;
    autoplayDone = false;
    autoplayTimer: number | null = null;
    operationTimer: number | null = null;
    observer: IntersectionObserver | null = null;
    abort = new AbortController();

    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";
      this.state = this.localizedInitialState();
      const signal = this.abort.signal;

      this.querySelectorAll<HTMLButtonElement>("[data-agent-tab]").forEach((button) => {
        button.addEventListener("click", () => this.selectAgentTab(button.dataset.agentTab === "cli" ? "cli" : "desktop"), { signal });
      });
      this.querySelectorAll<HTMLInputElement>("[data-agent-id] input[type=radio]").forEach((input) => {
        input.addEventListener("change", () => this.selectAgent(input.value), { signal });
      });
      this.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) => {
        button.addEventListener("click", () => this.performAction(button.dataset.action || ""), { signal });
      });
      this.querySelector<HTMLButtonElement>("[data-provider-trigger]")?.addEventListener("click", () => this.toggleProviderOptions(), { signal });
      this.querySelectorAll<HTMLButtonElement>("[data-provider-id]").forEach((button) => {
        button.addEventListener("click", () => this.selectProvider(button.dataset.providerId || ""), { signal });
      });
      this.querySelector<HTMLInputElement>("[data-probe-input]")?.addEventListener("input", (event) => {
        this.dispatch({ type: "set-probe-model", value: (event.currentTarget as HTMLInputElement).value });
      }, { signal });
      this.querySelector<HTMLButtonElement>("[data-test-connection]")?.addEventListener("click", () => this.startProbe(), { signal });
      this.querySelector<HTMLInputElement>("[data-model-input]")?.addEventListener("input", (event) => {
        this.selectModel((event.currentTarget as HTMLInputElement).value, false);
      }, { signal });
      this.querySelectorAll<HTMLButtonElement>("[data-model-id]").forEach((button) => {
        button.addEventListener("click", () => this.selectModel(button.dataset.modelId || ""), { signal });
      });
      this.querySelector<HTMLInputElement>("[data-profile-label]")?.addEventListener("input", (event) => {
        this.dispatch({ type: "set-profile-label", value: (event.currentTarget as HTMLInputElement).value });
      }, { signal });
      this.querySelector<HTMLButtonElement>("[data-cancel-task]")?.addEventListener("click", () => this.cancelInstall(), { signal });
      this.querySelector<HTMLButtonElement>("[data-close-task]")?.addEventListener("click", () => this.performAction("enter-overview"), { signal });
      this.querySelector<HTMLButtonElement>("[data-task-trigger]")?.addEventListener("click", () => this.dispatch({ type: "toggle-task-center" }), { signal });
      this.querySelector<HTMLButtonElement>("[data-dismiss-task]")?.addEventListener("click", () => this.dispatch({ type: "dismiss-task" }), { signal });
      this.querySelector<HTMLButtonElement>("[data-open-task]")?.addEventListener("click", () => {
        if (this.state.screen !== "install") this.state = { ...this.state, screen: "install", taskCenterOpen: true };
        this.render(true);
      }, { signal });
      this.querySelector<HTMLButtonElement>("[data-launch-agent]")?.addEventListener("click", () => {
        const note = this.querySelector<HTMLElement>("[data-launch-note]");
        if (note) note.hidden = false;
      }, { signal });
      this.querySelector<HTMLButtonElement>("[data-reset]")?.addEventListener("click", () => this.replay(), { signal });
      document.querySelectorAll<HTMLButtonElement>(`[data-activation-trigger="${this.id}"]`).forEach((button) => {
        button.addEventListener("click", () => {
          this.cancelAutoplay();
          this.replay();
        }, { signal });
      });

      for (const type of ["pointerdown", "keydown", "focusin"] as const) {
        this.addEventListener(type, () => this.cancelAutoplay(), { signal, capture: true });
      }

      this.render(false);
      this.armAutoplay();
    }

    disconnectedCallback() {
      this.clearTimers();
      this.observer?.disconnect();
      this.abort.abort();
    }

    get locale(): DemoLocale {
      return this.dataset.locale === "en" ? "en" : "zh-CN";
    }

    get reducedMotion(): boolean {
      return window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
    }

    localizedInitialState(): ActivationState {
      return {
        ...initialActivationState(scenario),
        profileLabel: scenario.newProfileLabels[this.locale],
      };
    }

    dispatch(action: ActivationAction, focus = true) {
      const previous = this.state.screen;
      this.state = activationReducer(this.state, action, scenario);
      if (action.type === "reset" || action.type === "start-new-profile") {
        this.state = { ...this.state, profileLabel: scenario.newProfileLabels[this.locale] };
      }
      if (action.type === "reuse-profile") {
        this.state = { ...this.state, profileLabel: scenario.existingProfile.labels[this.locale] };
      }
      this.render(focus && previous !== this.state.screen && !this.autoplaying);
    }

    selectAgentTab(tab: "cli" | "desktop") {
      this.dispatch({ type: "select-agent-tab", tab });
    }

    selectAgent(agentId: string) {
      this.dispatch({ type: "select-agent", agentId });
    }

    selectProvider(providerId: string) {
      const provider = catalog.providers.find((candidate) => candidate.id === providerId);
      this.dispatch({ type: "select-provider", providerId, defaultModel: provider?.defaultModel ?? "" });
      this.closeProviderOptions();
    }

    selectModel(model: string, focus = true) {
      this.dispatch({ type: "set-model", value: model.trim() }, false);
      this.render(focus && !this.autoplaying);
    }

    performAction(action: string) {
      switch (action) {
        case "continue-agents":
        case "reuse-profile":
        case "start-new-profile":
        case "continue-provider":
        case "continue-model":
        case "back":
          this.dispatch({ type: action });
          break;
        case "start-install":
          this.startInstall();
          break;
        case "enter-overview":
          this.enterOverview();
          break;
        case "refresh-models":
          this.flashModelNotice();
          break;
        case "replay":
          this.replay();
          break;
      }
    }

    startProbe() {
      if (this.state.screen !== "provider" || this.state.probeState === "loading") return;
      if (this.operationTimer !== null) window.clearTimeout(this.operationTimer);
      this.dispatch({ type: "start-probe" }, false);
      this.operationTimer = window.setTimeout(() => {
        this.operationTimer = null;
        this.dispatch({ type: "finish-probe", ok: true }, false);
      }, 850);
    }

    startInstall() {
      if (this.state.screen !== "review") return;
      if (this.operationTimer !== null) window.clearTimeout(this.operationTimer);
      this.dispatch({ type: "start-install" });
      this.operationTimer = window.setTimeout(() => {
        this.operationTimer = null;
        this.dispatch({ type: "finish-install" }, false);
      }, 2100);
    }

    cancelInstall() {
      if (this.operationTimer !== null) {
        window.clearTimeout(this.operationTimer);
        this.operationTimer = null;
      }
      this.dispatch({ type: "cancel-install" });
    }

    enterOverview() {
      if (this.state.screen !== "install") return;
      if (this.state.installState === "running") {
        if (this.operationTimer !== null) window.clearTimeout(this.operationTimer);
        this.operationTimer = null;
        this.dispatch({ type: "finish-install" }, false);
      }
      this.dispatch({ type: "enter-overview" });
      this.finishAutoplay();
    }

    replay() {
      this.clearOperationTimer();
      this.state = this.localizedInitialState();
      this.render(!this.reducedMotion);
      if (!this.reducedMotion) {
        const windowElement = this.querySelector<HTMLElement>("[data-console-window]");
        windowElement?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    flashModelNotice() {
      const notice = this.querySelector<HTMLElement>('[data-panel="model"] .activation-notice');
      if (!notice) return;
      notice.dataset.flash = "true";
      window.setTimeout(() => delete notice.dataset.flash, 500);
    }

    toggleProviderOptions() {
      const trigger = this.querySelector<HTMLButtonElement>("[data-provider-trigger]");
      const options = this.querySelector<HTMLElement>("[data-provider-options]");
      if (!trigger || !options) return;
      const open = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!open));
      options.hidden = open;
    }

    closeProviderOptions() {
      const trigger = this.querySelector<HTMLButtonElement>("[data-provider-trigger]");
      const options = this.querySelector<HTMLElement>("[data-provider-options]");
      trigger?.setAttribute("aria-expanded", "false");
      if (options) options.hidden = true;
    }

    armAutoplay() {
      if (this.reducedMotion || this.dataset.autoplay === "off" || typeof IntersectionObserver !== "function") return;
      this.observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        this.observer?.disconnect();
        this.observer = null;
        this.startAutoplay();
      }, { threshold: 0.5 });
      this.observer.observe(this);
    }

    startAutoplay() {
      if (this.autoplayDone || this.state.screen !== "agents") return;
      this.autoplaying = true;
      this.dataset.autoplaying = "true";
      this.queueAutoplay(0);
    }

    queueAutoplay(index: number) {
      const step = AUTOPLAY_SCRIPT[index];
      if (!step) return this.finishAutoplay();
      this.autoplayTimer = window.setTimeout(() => {
        this.autoplayTimer = null;
        if (!this.autoplaying) return;
        step.run(this);
        this.queueAutoplay(index + 1);
      }, step.delay);
    }

    cancelAutoplay() {
      if (!this.autoplaying && this.autoplayDone) return;
      if (this.autoplayTimer !== null) window.clearTimeout(this.autoplayTimer);
      this.autoplayTimer = null;
      this.autoplaying = false;
      this.autoplayDone = true;
      delete this.dataset.autoplaying;
    }

    finishAutoplay() {
      if (this.autoplayTimer !== null) window.clearTimeout(this.autoplayTimer);
      this.autoplayTimer = null;
      this.autoplaying = false;
      this.autoplayDone = true;
      delete this.dataset.autoplaying;
    }

    clearOperationTimer() {
      if (this.operationTimer !== null) window.clearTimeout(this.operationTimer);
      this.operationTimer = null;
    }

    clearTimers() {
      if (this.autoplayTimer !== null) window.clearTimeout(this.autoplayTimer);
      this.autoplayTimer = null;
      this.clearOperationTimer();
    }

    render(focusPanel = false) {
      this.dataset.screen = this.state.screen;
      this.dataset.phase = this.state.screen;
      this.dataset.route = routeForScreen(this.state.screen, this.state.agentId ?? scenario.selectedAgent.id);
      this.dataset.installState = this.state.installState;
      this.dataset.probeState = this.state.probeState;

      const activePanel = this.querySelector<HTMLElement>(`[data-panel="${this.state.screen}"]`);
      this.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.hidden = panel !== activePanel;
      });
      this.renderHeader(activePanel);
      this.renderStepper();
      this.renderFooter();
      this.renderAgents();
      this.renderProvider();
      this.renderProbe();
      this.renderModel();
      this.renderReview();
      this.renderInstall();
      this.renderOverview();
      this.renderTaskCenter();

      if (focusPanel) activePanel?.focus({ preventScroll: true });
    }

    renderHeader(panel: HTMLElement | null) {
      const title = this.querySelector<HTMLElement>("[data-page-title]");
      const description = this.querySelector<HTMLElement>("[data-page-description]");
      if (!title || !description || !panel) return;
      if (this.state.screen === "install") {
        const copy = runtimeCopy[this.locale];
        const statusTitle = this.state.installState === "success"
          ? copy.success
          : this.state.installState === "cancelled"
            ? copy.cancelled
            : this.state.installState === "failure"
              ? copy.failure
              : copy.installing;
        title.textContent = `${statusTitle} · ${scenario.selectedAgent.name}`;
        description.textContent = copy.installDescription;
        return;
      }
      title.textContent = panel.dataset.pageTitle || "";
      description.textContent = panel.dataset.pageDescription || "";
    }

    renderStepper() {
      const stepper = this.querySelector<HTMLElement>("[data-stepper]");
      if (!stepper) return;
      stepper.hidden = this.state.screen === "install" || this.state.screen === "overview";
      this.querySelectorAll<HTMLElement>("[data-step-id]").forEach((item) => {
        const id = item.dataset.stepId as Parameters<typeof stepPresentation>[1];
        const presentation = stepPresentation(this.state, id);
        item.dataset.presentation = presentation;
        if (presentation === "current") item.setAttribute("aria-current", "step");
        else item.removeAttribute("aria-current");
      });
    }

    renderFooter() {
      this.querySelectorAll<HTMLElement>("[data-footer-screen]").forEach((footer) => {
        footer.hidden = footer.dataset.footerScreen !== this.state.screen;
      });
      const continueAgent = this.querySelector<HTMLButtonElement>('[data-action="continue-agents"]');
      if (continueAgent) continueAgent.disabled = !this.state.agentId;
      const continueProvider = this.querySelector<HTMLButtonElement>('[data-action="continue-provider"]');
      if (continueProvider) continueProvider.disabled = !this.state.providerId;
      const continueModel = this.querySelector<HTMLButtonElement>('[data-action="continue-model"]');
      if (continueModel) continueModel.disabled = !this.state.model.trim();
      const startInstall = this.querySelector<HTMLButtonElement>('[data-action="start-install"]');
      if (startInstall) startInstall.disabled = this.state.profileMode === "new" && !this.state.profileLabel.trim();
      const installNote = this.querySelector<HTMLElement>("[data-install-footer-note]");
      if (installNote) installNote.textContent = this.state.installState === "running" ? runtimeCopy[this.locale].keepOpen : runtimeCopy[this.locale].finished;
    }

    renderAgents() {
      this.querySelectorAll<HTMLButtonElement>("[data-agent-tab]").forEach((button) => {
        const active = button.dataset.agentTab === this.state.agentTab;
        button.setAttribute("aria-selected", String(active));
        button.classList.toggle("is-active", active);
      });
      this.querySelectorAll<HTMLElement>("[data-agent-list]").forEach((list) => {
        list.hidden = list.dataset.agentList !== this.state.agentTab;
      });
      this.querySelectorAll<HTMLElement>("[data-agent-id]").forEach((row) => {
        const selected = row.dataset.agentId === this.state.agentId;
        row.classList.toggle("is-selected", selected);
        const input = row.querySelector<HTMLInputElement>('input[type="radio"]');
        if (input) input.checked = selected;
      });
      const note = this.querySelector<HTMLElement>("[data-agent-footer-note]");
      if (note) {
        const agent = catalog.agents.find((candidate) => candidate.id === this.state.agentId);
        note.textContent = agent?.name || note.dataset.idle || (this.locale === "en" ? "Select one agent" : "选择一个 Agent");
      }
    }

    renderProvider() {
      const provider = catalog.providers.find((candidate) => candidate.id === this.state.providerId) ?? scenario.provider;
      this.querySelector<HTMLElement>("[data-provider-name]")!.textContent = provider.name;
      this.querySelector<HTMLElement>("[data-provider-summary-name]")!.textContent = provider.name;
      this.querySelector<HTMLElement>("[data-provider-summary-url]")!.textContent = provider.baseUrl;
      const footer = this.querySelector<HTMLElement>("[data-provider-footer]");
      if (footer) footer.textContent = `${provider.baseUrl} · ${scenario.selectedAgent.protocol === "anthropic" ? "Anthropic Messages" : "OpenAI-compatible"}`;
      this.querySelectorAll<HTMLButtonElement>("[data-provider-id]").forEach((option) => {
        option.setAttribute("aria-selected", String(option.dataset.providerId === provider.id));
      });
    }

    renderProbe() {
      const status = this.querySelector<HTMLElement>("[data-probe-status]");
      if (status) status.dataset.probeStatus = this.state.probeState;
      this.querySelectorAll<HTMLElement>("[data-probe-copy]").forEach((copy) => {
        copy.hidden = copy.dataset.probeCopy !== this.state.probeState;
      });
      const input = this.querySelector<HTMLInputElement>("[data-probe-input]");
      if (input && input.value !== this.state.probeModel) input.value = this.state.probeModel;
      const button = this.querySelector<HTMLButtonElement>("[data-test-connection]");
      if (button) button.disabled = this.state.probeState === "loading";
    }

    renderModel() {
      const input = this.querySelector<HTMLInputElement>("[data-model-input]");
      if (input && input.value !== this.state.model) input.value = this.state.model;
      this.querySelectorAll<HTMLButtonElement>("[data-model-id]").forEach((button) => {
        const selected = button.dataset.modelId === this.state.model;
        button.setAttribute("aria-checked", String(selected));
        button.classList.toggle("is-selected", selected);
      });
    }

    renderReview() {
      const provider = catalog.providers.find((candidate) => candidate.id === this.state.providerId) ?? scenario.provider;
      this.querySelector<HTMLElement>("[data-review-provider]")!.textContent = provider.name;
      this.querySelector<HTMLElement>("[data-review-model]")!.textContent = this.state.model || provider.defaultModel;
      this.querySelector<HTMLElement>("[data-review-base]")!.textContent = provider.baseUrl;
      const newProfileField = this.querySelector<HTMLElement>("[data-new-profile-field]");
      if (newProfileField) newProfileField.hidden = this.state.profileMode === "reuse";
      const label = this.querySelector<HTMLInputElement>("[data-profile-label]");
      if (label && label.value !== this.state.profileLabel) label.value = this.state.profileLabel;
    }

    renderInstall() {
      const panel = this.querySelector<HTMLElement>('[data-panel="install"]');
      if (panel) panel.dataset.state = this.state.installState;
      const progress = this.querySelector<HTMLElement>("[data-install-progress]");
      if (progress) progress.hidden = this.state.installState !== "running";
      const cancel = this.querySelector<HTMLButtonElement>("[data-cancel-task]");
      if (cancel) cancel.hidden = this.state.installState !== "running";
      const close = this.querySelector<HTMLButtonElement>("[data-close-task]");
      if (close) close.hidden = this.state.installState === "running";
    }

    renderOverview() {
      const profile = this.querySelector<HTMLElement>("[data-overview-profile]");
      const model = this.querySelector<HTMLElement>("[data-overview-model]");
      if (profile) profile.textContent = this.state.profileLabel || scenario.newProfileLabels[this.locale];
      if (model) model.textContent = this.state.model || scenario.provider.defaultModel;
      this.querySelectorAll<HTMLElement>("[data-nav-id]").forEach((item) => {
        item.classList.toggle("is-active", this.state.screen === "overview" && item.dataset.navId === "overview");
      });
    }

    renderTaskCenter() {
      const popover = this.querySelector<HTMLElement>("[data-task-popover]");
      if (popover) popover.hidden = !this.state.taskCenterOpen;
      const trigger = this.querySelector<HTMLButtonElement>("[data-task-trigger]");
      trigger?.setAttribute("aria-expanded", String(this.state.taskCenterOpen));
      const status = this.querySelector<HTMLElement>("[data-task-status]");
      const icon = this.querySelector<HTMLElement>("[data-task-state]");
      if (!status || !icon) return;
      const copy = runtimeCopy[this.locale];
      if (this.state.installState === "success") {
        status.textContent = copy.taskSuccess;
        icon.textContent = "✓";
      } else if (this.state.installState === "cancelled") {
        status.textContent = copy.taskCancelled;
        icon.textContent = "⊘";
      } else if (this.state.installState === "failure") {
        status.textContent = copy.taskFailure;
        icon.textContent = "!";
      } else {
        status.textContent = copy.taskRunning;
        icon.textContent = "◌";
      }
    }
  }

  if (!customElements.get("activation-console")) {
    customElements.define("activation-console", ActivationConsoleElement);
  }
</script>

