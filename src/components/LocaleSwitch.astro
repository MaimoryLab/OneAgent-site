---
import { localeFromPath, localePath, locales, localeNames, routeWithoutLocale, isTranslated } from "../i18n";
import { useTranslations } from "../i18n/ui";

const current = localeFromPath(Astro.url.pathname);
const route = routeWithoutLocale(Astro.url.pathname);
const t = useTranslations(current);
const target = locales.find((locale) => locale !== current)!;
// Switching keeps the reader on the same page where that page is translated,
// and falls back to the home page rather than a 404 where it is not.
const targetHref = localePath(target, isTranslated(route) ? route : "");
---
{/* Shape, fill, hover and press come from .header-control in global.css, so this
    control, the theme toggle and the GitHub link read as one group. */}
<a class="locale-switch header-control" href={targetHref} hreflang={target} lang={target} aria-label={t("lang.switch")}>
  {localeNames[target]}
</a>
