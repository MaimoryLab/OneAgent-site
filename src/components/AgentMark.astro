---
interface Props {
  id: string;
  name: string;
  size?: number;
}
const { id, name, size = 24 } = Astro.props;
/* Only the marks whose source, license, owner and SHA-256 are recorded in
   public/images/agents/asset-rights.json. An agent absent from this map renders
   the letter fallback below, which is the intended state rather than a gap to
   fill: copying a vendor favicon into a public repository without an auditable
   redistribution basis is a licensing problem, and a trademark one besides.
   Upstream reaches the same conclusion in the other direction, using generic
   Lucide symbols where this site uses a letter.

   So the desktop applications and the coming-soon entries have no mark by
   design, not for want of one. */
const extensions: Record<string, string> = {
  codex: "svg",
  opencode: "svg",
};
/* Both marks ship as fill="currentColor". Loaded through <img> the keyword has
   no page to inherit from and falls back to black, which disappears on a dark
   ground — so they get inverted there. */
const monochrome = new Set(["codex", "opencode"]);
const extension = extensions[id];
const imageSource = extension ? `${import.meta.env.BASE_URL}images/agents/${id}.${extension}` : null;
---
<span class="agent-mark-wrap" style={`--mark-size:${size}px`} aria-hidden="true">
  {imageSource ? <img src={imageSource} alt="" width={size} height={size} loading="lazy" data-monochrome={monochrome.has(id) ? "" : undefined} /> : <span class="agent-fallback">{name.slice(0, 1)}</span>}
</span>
