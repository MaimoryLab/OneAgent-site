---
interface Props {
  id: string;
  name: string;
  size?: number;
}
const { id, name, size = 24 } = Astro.props;
/* Only the marks whose source, license, owner and SHA-256 are recorded in
   public/images/agents/asset-rights.json. An agent absent from this map renders
   the letter fallback below, which is the intended state rather than a gap to
   fill: copying a vendor favicon into a public repository without an auditable
   redistribution basis is a licensing problem, and a trademark one besides.
   Upstream reaches the same conclusion in the other direction, using generic
   Lucide symbols where this site uses a letter.

   So the desktop applications and the coming-soon entries have no mark by
   design, not for want of one. Aider is the same case: no mark exists in
   lobe-icons, it publishes no brand kit, and its Apache-2.0 code licence grants
   no trademark rights. */
/* Keyed by the file each id renders, so an id can point at a mark registered
   under another name. chatgpt-desktop is the one case: it is OpenAI's own app and
   shares Codex's configuration, so it renders the same OpenAI mark rather than a
   second copy of one file. Upstream reaches the same conclusion in
   frontend/src/components/icons/agents.tsx. */
const markFiles: Record<string, string> = {
  codex: "codex.svg",
  opencode: "opencode.svg",
  "claude-code": "claude-code.svg",
  "kilo-cli": "kilo-cli.svg",
  hermes: "hermes.svg",
  openclaw: "openclaw.svg",
  "chatgpt-desktop": "codex.svg",
};
/* All six marks ship as fill="currentColor". Loaded through <img> the keyword
   has no page to inherit from and falls back to black, which disappears on a
   dark ground — so they get inverted there.

   openclaw is here despite containing #000 and #fff: those are inside a <mask>,
   where black and white are channel values that punch out the eyes rather than
   colours that paint anything. Every visible path is currentColor like the rest. */
const monochrome = new Set(["codex", "opencode", "claude-code", "kilo-cli", "hermes", "openclaw", "chatgpt-desktop"]);
const markFile = markFiles[id];
const imageSource = markFile ? `${import.meta.env.BASE_URL}images/agents/${markFile}` : null;
---
<span class="agent-mark-wrap" style={`--mark-size:${size}px`} aria-hidden="true">
  {imageSource ? <img src={imageSource} alt="" width={size} height={size} loading="lazy" data-monochrome={monochrome.has(id) ? "" : undefined} /> : <span class="agent-fallback">{name.slice(0, 1)}</span>}
</span>
