---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, htmlLang, localeFromPath, localePath, locales, ogLocale, routeWithoutLocale, isTranslated } from "../i18n";
import { useTranslations } from "../i18n/ui";
import { getPreviewChannel } from "../lib/release-channel";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /* Overrides the canonical URL, which otherwise describes the current path.
     Needed by pages that stand in for another one — a retired URL kept alive for
     inbound links has to name its successor as canonical, or the two compete in
     search results for the same content. */
  canonicalPath?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const {
  title = t("site.title"),
  description = t("site.description"),
  image = "images/bootagent-overview.jpg",
  noindex = false,
  canonicalPath,
} = Astro.props;
const canonicalOrigin = Astro.site ?? Astro.url.origin;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, canonicalOrigin);
// Only pages that exist in both languages get alternates; pointing hreflang at
// an unbuilt path would advertise a 404 to crawlers.
const route = routeWithoutLocale(Astro.url.pathname);
const alternates = isTranslated(route)
  ? locales.map((code) => ({
      code,
      href: new URL(localePath(code, route), canonicalOrigin).toString(),
    }))
  : [];
const runtimeBaseUrl = new URL(import.meta.env.BASE_URL, Astro.url.origin);
const canonicalBaseUrl = new URL(import.meta.env.BASE_URL, canonicalOrigin);
const imageUrl = new URL(image.replace(/^\/+/, ""), canonicalBaseUrl);
// The square mark, for the places that want a brand logo rather than a
// screenshot: Organization.logo below, and the touch icon further down.
const logoUrl = new URL("images/brand/bootagent-logo.png", canonicalBaseUrl);
const homeUrl = new URL(localePath(locale, ""), canonicalOrigin);
const preview = await getPreviewChannel();
const availableSystems = preview?.targets
  .filter((target) => target.status === "available")
  .map((target) => `${target.platformLabel} ${target.archLabel}`) ?? [];
/* One @graph rather than three separate script tags, so the Organization can be
   referenced by @id as the software's publisher instead of being repeated.
   The Organization carries the logo: that is the property Google reads for the
   brand image beside a search result, and neither og:image nor the favicon is
   consulted for it. */
const organizationId = `${new URL("", canonicalOrigin)}#organization`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "BootAgent",
      url: new URL("", canonicalOrigin),
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: 1024,
        height: 1024,
        caption: "BootAgent",
      },
      sameAs: ["https://github.com/MaimoryLab/BootAgent"],
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: "BootAgent",
      url: homeUrl,
      inLanguage: htmlLang[locale],
      description,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "SoftwareApplication",
      name: "BootAgent",
      applicationCategory: "DeveloperApplication",
      /* Omitted rather than filled with prose when the feed has nothing
         published: an operatingSystem of "No public build" is not a value any
         consumer can read, and a wrong value is worse than an absent one. */
      ...(availableSystems.length > 0 ? { operatingSystem: availableSystems.join(", ") } : {}),
      ...(preview?.version ? { softwareVersion: preview.version } : {}),
      url: canonical,
      description,
      publisher: { "@id": organizationId },
      offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" },
    },
  ],
};
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* GitHub Pages cannot send response headers, so public/_headers is inert
        there and this meta tag is what actually applies a policy. Kept in sync
        with public/_headers by hand, for hosts that do read it.

        The two policies differ by necessity: frame-ancestors is invalid in a meta tag, so
        frame-src 'none' stands in — it restricts what this page may embed, not
        who may embed it. Clickjacking protection therefore needs a real
        X-Frame-Options or frame-ancestors header from the host. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; worker-src 'none'"
    />
    {/* The one other _headers entry a meta tag can carry. nosniff and
        Permissions-Policy cannot be set this way. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <!-- --paper per scheme, duplicated because the browser chrome reads the tag
         and cannot resolve var(). Move these with that token, and with
         site.webmanifest's background_color / theme_color. -->
    <meta name="theme-color" content="#efeae0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161410" media="(prefers-color-scheme: dark)" />
    {/* Runs before first paint and before the stylesheet, so the resolved theme
        is on <html> by the time anything is drawn. Deferring this to the module
        script would paint the light palette first and flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = window.localStorage.getItem("oneagent-theme");
          var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("theme-dark");
        } catch (error) {
          /* Private mode can throw on localStorage; the light default is fine. */
        }
      })();
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <base href={runtimeBaseUrl.toString()} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
    ))}
    {alternates.length > 0 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={alternates.find((alternate) => alternate.code === defaultLocale)!.href}
      />
    )}
    <!-- The SVG is listed first and wins wherever it is understood; the PNG is
         the fallback. The mark is two strokes, so at 16px the vector stays crisp
         where the raster has to guess. Both carry the ink ring rather than a
         theme-dependent one: a favicon has no document to inherit from. -->
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="favicon.png" type="image/png" sizes="64x64" />
    <!-- iOS ignores the manifest's icons when a page is added to the home
         screen, and falls back to a screenshot of the page without this. -->
    <link rel="apple-touch-icon" href="images/brand/bootagent-app-icon-192.png" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="alternate" type="text/plain" href="llms.txt" title="llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:site_name" content="BootAgent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {/* Dimensions let a card render the right shape before the image has
        downloaded; without them the first paint of a shared link reflows. They
        describe the default overview image, so a page passing its own `image`
        prop of a different aspect ratio should be given its own tags rather
        than inheriting these. */}
    <meta property="og:image:width" content="1215" />
    <meta property="og:image:height" content="690" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Twitter reads og:* for everything else, but not for alt text. */}
    <meta name="twitter:image:alt" content={title} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {/* For tags that have to sit in <head> and cannot be expressed as props —
        currently the meta refresh on retired URLs. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("skip.main")}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
