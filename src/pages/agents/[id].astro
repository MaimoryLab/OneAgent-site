---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentMark from "../../components/AgentMark.astro";
import { catalog } from "../../lib/catalog";
import { platformLabels, protocolLabels } from "../../lib/content";
import { localeFromPath } from "../../i18n";
import { useCatalogLabels } from "../../i18n/catalog";
import { supportLabels } from "../../lib/downloads";
import type { SiteAgent } from "../../lib/explorer";

export function getStaticPaths() {
  return catalog.agents.map((agent) => ({ params: { id: agent.id }, props: { agent } }));
}
interface Props { agent: SiteAgent }
const { agent } = Astro.props;
const planned = agent.status === "planned";
const labels = supportLabels(agent.support);
const { agentDescriptions, groupLabels, statusLabels, kindLabels, plannedNote } = useCatalogLabels(localeFromPath(Astro.url.pathname));
---
<BaseLayout title={`${agent.name} — BootAgent Agent 兼容目录`} description={agentDescriptions[agent.id] ?? `${agent.name} 在 BootAgent 中的安装、配置和协议支持状态。`}>
  <header class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <nav class="breadcrumb" aria-label="面包屑"><a href="">首页</a> / <a href="agents/">Agent</a> / {agent.name}</nav>
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:18px"><AgentMark id={agent.id} name={agent.name} size={30} /><p class="eyebrow" style="margin:0">{groupLabels[agent.group] ?? agent.group}</p></div>
        <h1 class="page-title">{agent.name}</h1>
      </div>
      <div class="page-hero-aside"><strong>{agentDescriptions[agent.id] ?? "按公开能力提供安装或配置支持。"}</strong>{planned ? plannedNote : agent.support.managedInstall ? "默认安装 Agent 官方渠道最新版本。" : "版本由 Agent 官方渠道管理。"}</div>
    </div>
  </header>
  <section class="section-compact">
    <div class="shell">
      {planned ? (
        /* Every cell below reads a support contract out of the catalog entry. A
           planned agent has none, so the page says that once instead of
           printing four cells of nulls dressed as facts. */
        <div class="notice notice-info"><span class="notice-mark">i</span><div><strong>{statusLabels.planned}</strong><p>{plannedNote}它还没有进入 BootAgent 的安装清单，因此这里没有可以核对的安装、配置、协议或平台事实。</p></div></div>
      ) : (
      <div class="detail-grid">
        <div class="detail-cell"><span>类型</span><strong>{kindLabels[agent.kind]}</strong><p>{agent.kind === "desktop" ? "桌面应用从厂商下载渠道安装，没有命令行入口。" : "由包管理器安装，可用命令行探测版本。"}</p></div>
        <div class="detail-cell"><span>安装支持</span><strong>{agent.support.managedInstall ? "BootAgent 可管理安装" : "按官方方式安装"}</strong><p>{agent.kind === "desktop" ? "从厂商自己的下载地址取当前版本，不重新分发安装包。" : agent.support.managedInstall ? "使用清单中的官方包名，默认解析最新版本。" : "选择后返回官方指引，不捆绑第三方二进制。"}</p></div>
        <div class="detail-cell"><span>配置支持</span><strong>{agent.support.managedConfig ? "BootAgent 可管理配置" : "由 Agent 官方流程管理"}</strong><p>{agent.configPath ? `写入 ~/${agent.configPath}。` : ""}底层配置文件不同本身不构成新增 UI 字段的理由。</p></div>
        <div class="detail-cell"><span>推理协议</span><strong>{agent.protocol ? protocolLabels[agent.protocol] : "不由 BootAgent 代配协议"}</strong><p>连接测试按 Agent 的真实协议执行，不只依赖模型列表。</p></div>
        <div class="detail-cell"><span>平台</span><strong>{agent.platforms.length > 0 ? agent.platforms.map((id) => platformLabels[id] ?? id).join(" · ") : "尚未公布"}</strong><p>具体产物是否公开仍取决于平台原生发行门禁。</p></div>
      </div>
      )}
      <div class="section-compact wide-narrow">
        {!planned && <div class="agent-status" style="margin-bottom:26px">{labels.map((label) => <span class="chip">{label}</span>)}</div>}
        {agent.guide && <div class="notice notice-info"><span class="notice-mark">i</span><div><strong>官方流程摘要</strong><p>{agent.guide}</p></div></div>}
        <div class="prose">
          <h2>来源与许可证</h2>
          {agent.source ? <p>锁定包来源：<a href={agent.source} rel="noreferrer">项目公开来源</a>。</p> : <p>BootAgent 不重新分发该 Agent；请从其官方渠道获取。</p>}
          {agent.license && <p>当前锁定包声明的许可证：{agent.license}{agent.licenseUrl && <>，<a href={agent.licenseUrl} rel="noreferrer">查看许可证文本</a></>}。</p>}
          <h2>为什么表单没有为它无限扩展？</h2>
          <p>BootAgent 只暴露会改变用户意图、且后端真实支持写入的选择。任意 headers、代理转换、共享网关或原始配置 JSON 不会因为其他工具提供了它们，就成为 BootAgent 的承诺。</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
