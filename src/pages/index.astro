---
import ActivationConsole from "../components/ActivationConsole.astro";
import AgentMark from "../components/AgentMark.astro";
import BrandMark from "../components/BrandMark.astro";
import HeroParticles from "../components/HeroParticles.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalog } from "../lib/catalog";
import { localePath } from "../i18n";
import { useCatalogLabels } from "../i18n/catalog";

/* The channel and version used to be printed under the hero actions. They now
   live on /downloads/ and /security/ only: the version is a property of today's
   build rather than of the product, and leading the home page with "unsigned"
   made the signing status the first thing said about BootAgent — to readers and
   to search engines, which were quoting that line back as the page's summary.
   Both pages still state it in full, and the footer links to /security/. */
/* Only agents the catalog can describe a support contract for. Slicing the
   catalog positionally would put a coming-soon entry on the home page as soon as
   one outranked an installable agent, in a section whose whole claim is that the
   compatibility it shows is real. */
const availableAgents = catalog.agents.filter((agent) => agent.status === "available");
const cliCount = availableAgents.filter((agent) => agent.kind === "cli").length;
const desktopCount = availableAgents.length - cliCount;
const primaryAgents = availableAgents.slice(0, 6);
const { agentDescriptions, groupLabels, agentFallbackDescription } = useCatalogLabels("zh-CN");
const href = (path: string) => localePath("zh-CN", path);
---
<BaseLayout>
  <section class="hero">
    <HeroParticles />
    <div class="shell hero-copy">
      <div>
        {/* The mark at display size, paired with the name. The header's copy is
            26px and scrolls away; this is the one place the logo is presented as
            the brand rather than as a nav affordance. aria-hidden on the SVG
            inside BrandMark, so the name beside it carries the text. */}
        <p class="hero-brand"><span class="hero-brand-mark"><BrandMark size={44} /></span><span>BootAgent</span></p>
        <h1 class="display">一个入口，<br /><em>激活你的 AI 开发环境。</em></h1>
      </div>
      <div class="hero-side">
        <p class="lede">从 Agent 到 Provider，再到真实协议验证。下面这个示例流程可以直接点，真正的扫描、写入与备份都在本地 BootAgent 里完成。</p>
        <div class="hero-actions">
          <button class="button button-primary" type="button" data-activation-trigger="activation-console" aria-controls="activation-console">开始激活演示</button>
        </div>
      </div>
    </div>
    <ActivationConsole />
  </section>

  <section class="section">
    <div class="shell reveal">
      <div class="section-heading">
        <div><p class="eyebrow">激活流程</p><h2 class="section-title">检测、连接、验证，每一步都能解释。</h2></div>
        <p>配置、备份与凭证都留在本机。任何写入之前，先验证这个 Agent 真正需要的那个协议。</p>
      </div>
      <div class="steps">
        <article class="step"><h3>识别环境</h3><p>已安装、待配置、只能走官方流程——三种状态分开列出，装了和配好了是两件事。</p></article>
        <article class="step"><h3>连接 Provider</h3><p>按 Agent 所需协议筛选 Provider，也可以填你自己的端点。兼容等级逐项标明。</p></article>
        <article class="step"><h3>验证并复核</h3><p>验证通过后，给出 Ready 状态、写入位置、备份情况和下一条命令。</p></article>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell reveal">
      <div class="section-heading">
        <div><p class="eyebrow">兼容目录</p><h2 class="section-title">目录来自真实仓库数据，不是一张静态兼容表。</h2></div>
        <p>{availableAgents.length} 个 Agent（{cliCount} 个命令行、{desktopCount} 个桌面端）与 {catalog.providers.length} 个公开 Provider，安装、配置与连接验证的支持状态逐项标注。</p>
      </div>
      <div class="agent-list">
        {primaryAgents.map((agent) => (
          <a class="agent-row" href={href(`explore/?agent=${agent.id}`)}>
            <AgentMark id={agent.id} name={agent.name} />
            <div><strong>{agent.name}</strong><span class="agent-meta">{groupLabels[agent.group] ?? agent.group}</span></div>
            <span class="agent-meta">{agentDescriptions[agent.id] ?? agentFallbackDescription}</span>
            <div class="agent-status">
              {agent.support.managedInstall ? <span class="chip chip-green">托管安装</span> : <span class="chip">官方引导</span>}
              {agent.support.managedConfig ? <span class="chip chip-accent">托管配置</span> : <span class="chip">官方配置</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="section-actions"><a class="button button-secondary" href={href("explore/")}>打开完整配置目录</a></div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-grid reveal">
      <div><h2>先在示例里看清流程，再在本机真正激活。</h2><p>下载 BootAgent 完成本地检测、配置备份与协议验证；团队基线和内部交付仍然不接管 API Key。</p></div>
      <div class="cta-actions">
        <a class="button button-primary" href={href("downloads/")}>下载 BootAgent</a>
        <a class="button button-secondary" href={href("enterprise/")}>了解团队服务</a>
      </div>
    </div>
  </section>
</BaseLayout>
